{CheckAttachCortexM7_0
	int @time
	int @time2
	int M7CoreIndex
	err_flg = 0
	M7CoreIndex = A53CORENO;
	@AttachCortexM7_0
	@time = GetTimeCounter()
	while{IsRunning(M7CoreIndex)
		if{HitEscKey()
			MessageBox(0, 0, "CortexM7_0のアタッチ処理を中断しました。")
			err_flg = 1
			break
		}
		@time2 = GetTimeCounter()
		if{(@time2-@time) > TIMEOUT
			MessageBox(0, 0, "CortexM7_0のアタッチ処理をタイムアウトしました。")
			err_flg = 1
			break
		}	
	}
}
