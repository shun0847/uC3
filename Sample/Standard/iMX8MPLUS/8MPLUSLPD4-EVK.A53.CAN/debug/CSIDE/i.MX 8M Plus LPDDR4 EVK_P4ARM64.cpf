	CPU_SystemMenuAdd2("Halt on Debug Info",           "@HaltOnDebugInfo",2);
	CPU_SystemMenuAdd2("OSLock release(All cores)",    "@OSUnlock",0);
	CPU_SystemMenuAdd2("","",0);	
	CPU_SystemMenuAdd2("- セットアップ説明書を開く(8MPLUSLPD4-EVK)","@OpenManual",0);
