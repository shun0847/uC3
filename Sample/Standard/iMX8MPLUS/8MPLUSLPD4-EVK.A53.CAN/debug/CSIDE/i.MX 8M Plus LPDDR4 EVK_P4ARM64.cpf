	CPU_SystemMenuAdd("","");
	CPU_SystemMenuAdd2("Resume","",1);
	CPU_SystemMenuAdd2("BreakCheckResume(All cores)",  "@BreakCheckResumeAll",2);
	CPU_SystemMenuAdd2("BreakCheckResume(A53)",        "@BreakCheckResumeA53",2);
