{@SetSystemMenuAArch64
	NewMacroFileLoad
	CPU_SystemMenuRemoveAll()
	CPU_SystemMenuAdd("Initialize hardware",     "@iMX8MInit 64");
	if{A53CORENO >= 0x2
		CPU_SystemMenuAdd("Attach(Cortex-A53_1)",  "@AttachCortexA53_1");
	}
	if{A53CORENO >= 0x4
		CPU_SystemMenuAdd("Attach(Cortex-A53_2_3)","@AttachCortexA53_2_3");
	}
	CPU_SystemMenuAdd("Attach(Cortex-M7_0)",     "@AttachCortexM7_0");
	CPU_SystemMenuAdd("Attach(All cores)",       "@AttachAll");
	CPU_SystemMenuAdd("","");
	CPU_SystemMenuAdd("Break start(All cores)",  "@iMX8MInitBreakAArch 64");
	CPU_SystemMenuAdd("Run start(All cores)",    "@iMX8MInitRun");
	CPU_SystemMenuAdd("","");
