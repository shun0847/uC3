{@iMX8MInit
	@BreakCheckSuspendAll
	CsideBootMode2(0, 1)	//Break
	CsideBootMode2(1, 2)	//Run
	CsideBootMode2(2, 2)	//Run
	CsideBootMode2(3, 2)	//Run
	CsideBootMode2(4, 2)	//Run
	err_flg = 0
	ProbePowerCheck(false)
	InitializationWithoutReset(false)
	SystemInit(1);
	@CMacroHeapArea
	
	CORTEX_A53_AARCH = %0
	BreakCheckResume(1)
	SelectCoreNo(0);
	CheckBreakCortexA53_0
	if{err_flg == 0
		CMacroCallEntity("system", "WdtDebugStateSuspendCounterAndPowerDownCounterDisable(1);")
		CMacroCallEntity("system", "Set_SEC_DEBUG();")
	}
	CsideBootMode2(0, 2)	//Run
	CsideBootMode2(1, 2)	//Run
	CsideBootMode2(2, 2)	//Run
	CsideBootMode2(3, 2)	//Run
	CsideBootMode2(4, 2)	//Run
}
{@SetSystemMenu
	@SetSystemMenuAArch64
}
{@iMX8MInitRun
	@BreakCheckSuspendAll
	CsideBootMode2(0, 2)	//Run
	CsideBootMode2(1, 2)	//Run
	CsideBootMode2(2, 2)	//Run
	CsideBootMode2(3, 2)	//Run
	CsideBootMode2(4, 2)	//Run
	RealtimeUpdate(false);
	
	MessageBox(0, 0, "Please cycle the target system power.")
	ProbePowerCheck(false)
	InitializationWithoutReset(true)
	SystemInit(1);
	@CMacroHeapArea
	InitializationWithoutReset(false)
	
	RealtimeUpdate(true);
	
	@OSUnlock
	
	SelectCoreNo(0);
}
{CheckAttachCortexA53_0
	int @time
	int @time2
	err_flg = 0
	@AttachCortexA53_0
	@time = GetTimeCounter()
	while{IsRunning(0)
		if{HitEscKey()
			MessageBox(0, 0, "CortexA53_0のアタッチ処理を中断しました。")
			err_flg = 1
			break
		}
		@time2 = GetTimeCounter()
		if{(@time2-@time) > TIMEOUT
			MessageBox(0, 0, "CortexA53_0のアタッチ処理をタイムアウトしました。")
			err_flg = 1
			break
		}	
	}
}
{CheckAttachCortexA53_1
	int @time
	int @time2
	err_flg = 0
	@AttachCortexA53_1
	@time = GetTimeCounter()
	while{IsRunning(1)
		if{HitEscKey()
			MessageBox(0, 0, "CortexA53_1コア1のアタッチ処理を中断しました。")
			err_flg = 1
			break
		}
		@time2 = GetTimeCounter()
		if{(@time2-@time) > TIMEOUT
			MessageBox(0, 0, "CortexA53_1のアタッチ処理をタイムアウトしました。")
			err_flg = 1
			break
		}	
	}
}
{NewMacroFileLoad
	CMacroSelectEntity("system")
	//Read cmacro files
	CMacroLoad("$(SysMacro)\i.MX8M Plus_CPU.cmac") 
	CMacroAppend("$(SysMacro)\i.MX8M Plus_DDR.cmac") 
	CMacroAppend("$(SysMacro)\i.MX8M Yocto BSP_ L6_155_2_2_0.cmac") 
	//
	CMacroSelectEntity("user")
}
{@HaltOnDebugEnable
	CMacroCallEntity("system", "HaltOnDebug_Enable();")
}
{CheckBreakCortexA53_0
	int @time
	int @time2
	err_flg = 0
	@time = GetTimeCounter()
	while{IsRunning(0)
		if{HitEscKey()
			MessageBox(0, 0, "CortexA53_0のブレーク確認処理を中断しました。")
			err_flg = 1
			break
		}
		@time2 = GetTimeCounter()
		if{(@time2-@time) > TIMEOUT
			MessageBox(0, 0, "CortexA53_0のブレーク確認ができませんでした(タイムアウト)。")
			err_flg = 1
			break
		}	
	}
}
{@AttachAll
	err_flg = 0
	CheckAttachCortexA53_0
	
	if{A53CORENO >= 0x2
		if{err_flg == 0
			CheckAttachCortexA53_1
		}
	}
	
	if{A53CORENO >= 0x4
		if{err_flg == 0
			CheckAttachCortexA53_2_3
		}
	}
	
	if{err_flg == 0
		CheckAttachCortexM7_0
	}	
}
{@AttachCortexM7_0
	CMacroCallEntity("system", "AttachCortexM7(0x1);")
}
{CheckAttachCortexA53_2_3
	int @time
	int @time2
	err_flg = 0
	@AttachCortexA53_2_3
	@time = GetTimeCounter()
	while{IsRunning(2)
		if{HitEscKey()
			MessageBox(0, 0, "CortexA53_2のアタッチ処理を中断しました。")
			err_flg = 1
			break
		}
		@time2 = GetTimeCounter()
		if{(@time2-@time) > TIMEOUT
			MessageBox(0, 0, "CortexA53_2のアタッチ処理をタイムアウトしました。")
			err_flg = 1
			break
		}	
	}
	if{err_flg == 0
		@time = GetTimeCounter()
		while{IsRunning(3)
			if{HitEscKey()
				MessageBox(0, 0, "CortexA53_3のアタッチ処理を中断しました。")
				err_flg = 1
				break
			}
			@time2 = GetTimeCounter()
			if{(@time2-@time) > TIMEOUT
				MessageBox(0, 0, "CortexA53_3のアタッチ処理をタイムアウトしました。")
				err_flg = 1
				break
			}	
		}
	}
}
{@SystemMacroReload
	int mret
	mret = MessageBox(1, 0, "システム・マクロの再読み込みを行ってマクロを初期状態に復帰します。\nユーザ設定値などは初期化されません。処理を継続しますか。")
	if{mret == 1
		NewMacroFileLoad
	}
}
{TOPPERS_MenuAdd
	CMacroCreateEntity("toppers")
	CMacroAppend("$(SysMacro)\i.MX8M TOPPERS(FMP3_ASP3).cmac") 
	CMacroSelectEntity("user")
}
{@OSUnlock
	CMacroCallEntity("system", "OSUnlock();")
}
