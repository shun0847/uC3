	@NumNum = 0


	@LineNum = 0


	@TurnNum = 0


	@CPSRNum = 0


}
{@BreakCheckSuspendAll
	CMacroCallEntity("system", "BreakCheckSuspendAll();")
}
{@iMX8MInitBreakAArch
	@BreakCheckSuspendAll
	CsideBootMode2(0, 1)	//Break
	CsideBootMode2(1, 2)	//Run
	CsideBootMode2(2, 2)	//Run
	CsideBootMode2(3, 2)	//Run
	CsideBootMode2(4, 2)	//Run
	SelectCoreNo(0);
	ProbePowerCheck(false)
	InitializationWithoutReset(false)
	SystemInit(1);
	@CMacroHeapArea
	
	CORTEX_A53_AARCH = %0
	CheckAttachCortexA53_0
	if{err_flg == 0
		CMacroCallEntity("system", "WdtDebugStateSuspendCounterAndPowerDownCounterDisable(1);")
		CMacroCallEntity("system", "Set_SEC_DEBUG();")
	}	
	if{A53CORENO >= 0x2
		if{err_flg == 0
			CheckAttachCortexA53_1
		}
	}
	
	if{A53CORENO >= 0x4
		if{err_flg == 0
			CheckAttachCortexA53_2_3
		}
	}
	if{err_flg == 0
		CheckAttachCortexM7_0
	}	
	SelectCoreNo(0);
	CsideBootMode2(0, 2)	//Run
	CsideBootMode2(1, 2)	//Run
	CsideBootMode2(2, 2)	//Run
	CsideBootMode2(3, 2)	//Run
	CsideBootMode2(4, 2)	//Run
}
{@OpenManual
	ShellExecuteCommand("$(SysMacro)\CM1834 i.MX 8M Plus LPDDR4 EVKセットアップ説明書.pdf",,)
}
{@BreakCheckResumeA53
	if{A53CORENO >= 0x4
		BreakCheckResume(0xF);
	} else if { A53CORENO >= 0x2
		BreakCheckResume(0x3);
	} else {
		BreakCheckResume(0x1);
	}
}
