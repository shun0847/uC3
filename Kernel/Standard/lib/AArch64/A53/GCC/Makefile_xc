MAKE        = make --no-print-directory

.PHONY: all rebuild clean
all:
	$(MAKE) -f libuC3xclp64aarch64l.mak
	$(MAKE) -f libuC3xclp64aarch64fl.mak
clean:
	$(MAKE) -f libuC3xclp64aarch64l.mak clean
	$(MAKE) -f libuC3xclp64aarch64fl.mak clean

rebuild: clean all
